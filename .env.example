NEXT_PUBLIC_FIREBASE_API_KEY=<YOUR_API_KEY>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<YOUR_AUTH_DOMAIN>
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<YOUR_PROJECT_ID>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<YOUR_STORAGE_BUCKET>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<YOUR_MESSAGING_SENDER_ID>
NEXT_PUBLIC_FIREBASE_APP_ID=<YOUR_APP_ID>

# iCloud Mail: https://support.apple.com/fr-fr/102525
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USER=<YOUR_ICLOUD_ADDRESS>
# App-specific password from account.apple.com, NOT your Apple ID password
SMTP_PASSWORD=<YOUR_SMTP_APP_PASSWORD>
# Must be your iCloud address or a verified alias, otherwise iCloud rejects the message
SMTP_FROM_MAIL=<YOUR_ICLOUD_ADDRESS>
SMTP_EMAIL_RECEIVER=<YOUR_SMTP_EMAIL_RECEIVER>
